{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Server (dev)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@paperclipai/server", "dev"],
      "port": 3100
    },
    {
      "name": "Server (watch)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@paperclipai/server", "dev:watch"],
      "port": 3100
    },
    {
      "name": "UI (Vite HMR)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@paperclipai/ui", "dev"],
      "port": 5173
    },
    {
      "name": "Dev Runner (watch)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-runner.mjs", "watch"],
      "port": 3100
    },
    {
      "name": "Production Server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["start.sh"],
      "port": 3100
    },
    {
      "name": "Docs (Mintlify)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["mintlify", "dev"],
      "port": 3000
    }
  ]
}
